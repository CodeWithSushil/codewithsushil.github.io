root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 4 space indentation
[*.yml]
indent_style = space
indent_size = 4

# Tab indentation (no size specified)
[*.md]
trim_trailing_whitespace = false
indent_style = tab

[*.css]
indent_style = space
indent_size = 2

